{
  "name": "release-tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [{ "actor_id": 1, "actor_type": "OrganizationAdmin", "bypass_mode": "always" }],
  "conditions": {
    "ref_name": { "include": ["refs/tags/v*"], "exclude": [] },
    "repository_name": { "include": ["~ALL"], "exclude": [] }
  },
  "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }, { "type": "update" }]
}
