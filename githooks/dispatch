#!/usr/bin/env bash
# Machine-wide git hook dispatcher. Usage: dispatch <hook-name> [hook args...]
#
# pre-commit runs the repository's own hook first, if it has one: .githooks/pre-commit, else
# .husky/pre-commit, else `lefthook run pre-commit` when lefthook is configured and installed.
# It then runs the repository's verify command (`bun run verify`, then `cargo xtask verify`, then
# `make verify`) on the staged files only, with the same contract CI uses: CI_CHANGES_FULL=false,
# CI_CHANGES_FILES (the staged paths), CI_CHANGES_BASE=HEAD, and ci-scope, ci-rust-packages and
# ci-go-packages on PATH. A verify that never reads that contract would check the whole repository,
# so it is left to CI (ECLEAN_FULL_VERIFY=1 runs it anyway). A staged tree that already passed is not
# verified again (amends, re-commits). A failing verify blocks the commit. ECLEAN_SKIP_VERIFY=1 skips
# the verify step (loudly logged); `git commit --no-verify` skips every hook. Every other hook does
# nothing of its own. Every hook then chains to the repository's .git/hooks/<name>, so installing the
# global hooks path does not silently disable hooks a clone already had.
set -uo pipefail

name="${1:?hook name}"
shift
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# detect_verify_cmd: echoes the repo's verify command, or returns 1 if none is found.
detect_verify_cmd() {
  if [ -f package.json ] && grep -q '"verify"[[:space:]]*:' package.json; then echo "bun run verify"
  elif [ -f Cargo.toml ] && [ -d xtask ]; then echo "cargo xtask verify"
  elif [ -f Makefile ] && grep -q '^verify:' Makefile; then echo "make verify"
  else return 1
  fi
}

# change_aware: true when the verify chain reads the changed-files contract (ci-scope and friends).
change_aware() {
  git grep -qE 'ci-scope|ci-rust-packages|ci-go-packages|CI_CHANGES_(FULL|FILES|BASE)' -- \
    package.json Makefile xtask scripts dev .githooks 2> /dev/null
}

# A repo-local core.hooksPath wins. Git does not call this dispatcher then; if it is reached
# anyway, hand over to the repo's directory and say so.
local_path="$(git config --local --get core.hooksPath 2>/dev/null || true)"
if [ -n "$local_path" ]; then
  case "$local_path" in /*) dir="$local_path" ;; *) dir="$(git rev-parse --show-toplevel)/$local_path" ;; esac
  if [ "$(cd "$dir" 2>/dev/null && pwd -P)" != "$self" ]; then
    echo "eclean-githooks: warning: repo sets core.hooksPath=$local_path; the repo's hooks win over the global dispatcher" >&2
    if [ -x "$dir/$name" ]; then exec "$dir/$name" "$@"; fi
    exit 0
  fi
fi

if [ "$name" = pre-commit ]; then
  top="$(git rev-parse --show-toplevel)"
  cd "$top" || exit 1
  if [ -x .githooks/pre-commit ]; then
    .githooks/pre-commit "$@" || exit $?
  elif [ -f .husky/pre-commit ]; then
    sh .husky/pre-commit "$@" || exit $?
  elif { [ -f lefthook.yml ] || [ -f lefthook.yaml ] || [ -f lefthook.json ] || [ -f .lefthook.yml ]; } && command -v lefthook >/dev/null 2>&1; then
    lefthook run pre-commit "$@" || exit $?
  fi

  gitdir_local="$(git rev-parse --absolute-git-dir)"
  staged="$gitdir_local/eclean-staged-files"
  git diff --cached --name-only --no-renames --diff-filter=d > "$staged"
  if [ "${ECLEAN_SKIP_VERIFY:-0}" = 1 ]; then
    echo "eclean-githooks: *** ECLEAN_SKIP_VERIFY=1 set; skipping verify for this commit ***" >&2
  elif [ ! -s "$staged" ]; then
    : # Nothing staged to check (deletions only, --allow-empty).
  elif cmd="$(detect_verify_cmd)"; then
    tree="$(git write-tree)"
    passed="$gitdir_local/eclean-verified"
    full="${ECLEAN_FULL_VERIFY:-0}"
    if [ -f "$passed/$tree" ]; then
      echo "eclean-githooks: staged tree ${tree:0:12} already passed $cmd; not verifying again" >&2
    elif [ "$full" != 1 ] && ! change_aware; then
      echo "eclean-githooks: $cmd checks the whole repository (it does not use ci-scope); CI runs it. ECLEAN_FULL_VERIFY=1 runs it here" >&2
    else
      if [ "$full" = 1 ]; then
        echo "eclean-githooks: running full verify before commit: $cmd" >&2
        export CI_CHANGES_FULL=true
      else
        echo "eclean-githooks: verifying $(grep -c . "$staged") staged files: $cmd" >&2
        export CI_CHANGES_FULL=false CI_CHANGES_FILES="$staged" CI_CHANGES_BASE=HEAD
      fi
      export PATH="$self/bin:$PATH"
      if ! out="$(bash -c "$cmd" 2>&1)"; then
        echo "eclean-githooks: verify failed ($cmd); commit blocked" >&2
        printf '%s\n' "$out" | tail -n 40 >&2
        exit 1
      fi
      # The tools read the working tree: only remember the tree when it is what was staged.
      if git diff --quiet; then
        mkdir -p "$passed" && : > "$passed/$tree"
        # Keep the 50 newest.
        # shellcheck disable=SC2012 # Plain hex names.
        ls -1t "$passed" | tail -n +51 | while IFS= read -r old; do rm -f "$passed/$old"; done
      fi
    fi
  fi
fi

gitdir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$gitdir" ] && [ -x "$gitdir/hooks/$name" ]; then
  exec "$gitdir/hooks/$name" "$@"
fi
exit 0
