#!/usr/bin/env bash
# Machine-wide git hook dispatcher. Usage: dispatch <hook-name> [hook args...]
#
# pre-commit runs the repository's own hook first, if it has one: .githooks/pre-commit, else
# .husky/pre-commit, else `lefthook run pre-commit` when lefthook is configured and installed.
# It then runs the repository's full verify command (`bun run verify`, then `cargo xtask verify`,
# then `make verify`); a failing verify blocks the commit. Set ECLEAN_SKIP_VERIFY=1 to skip the full
# verify step (loudly logged), or use `git commit --no-verify` to skip every hook. Every other hook
# does nothing of its own: heavy checks run in CI. Every hook then chains to the repository's
# .git/hooks/<name>, so installing the global hooks path does not silently disable hooks a clone
# already had.
set -uo pipefail

name="${1:?hook name}"
shift
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# detect_verify_cmd: echoes the repo's verify command, or returns 1 if none is found.
detect_verify_cmd() {
  if [ -f package.json ] && grep -q '"verify"[[:space:]]*:' package.json; then echo "bun run verify"
  elif [ -f Cargo.toml ] && [ -d xtask ]; then echo "cargo xtask verify"
  elif [ -f Makefile ] && grep -q '^verify:' Makefile; then echo "make verify"
  else return 1
  fi
}

# A repo-local core.hooksPath wins. Git does not call this dispatcher then; if it is reached
# anyway, hand over to the repo's directory and say so.
local_path="$(git config --local --get core.hooksPath 2>/dev/null || true)"
if [ -n "$local_path" ]; then
  case "$local_path" in /*) dir="$local_path" ;; *) dir="$(git rev-parse --show-toplevel)/$local_path" ;; esac
  if [ "$(cd "$dir" 2>/dev/null && pwd -P)" != "$self" ]; then
    echo "eclean-githooks: warning: repo sets core.hooksPath=$local_path; the repo's hooks win over the global dispatcher" >&2
    if [ -x "$dir/$name" ]; then exec "$dir/$name" "$@"; fi
    exit 0
  fi
fi

if [ "$name" = pre-commit ]; then
  top="$(git rev-parse --show-toplevel)"
  cd "$top" || exit 1
  if [ -x .githooks/pre-commit ]; then
    .githooks/pre-commit "$@" || exit $?
  elif [ -f .husky/pre-commit ]; then
    sh .husky/pre-commit "$@" || exit $?
  elif { [ -f lefthook.yml ] || [ -f lefthook.yaml ] || [ -f lefthook.json ] || [ -f .lefthook.yml ]; } && command -v lefthook >/dev/null 2>&1; then
    lefthook run pre-commit "$@" || exit $?
  fi

  if [ "${ECLEAN_SKIP_VERIFY:-0}" = 1 ]; then
    echo "eclean-githooks: *** ECLEAN_SKIP_VERIFY=1 set; skipping full verify for this commit ***" >&2
  elif cmd="$(detect_verify_cmd)"; then
    echo "eclean-githooks: running full verify before commit: $cmd" >&2
    if ! out="$(bash -c "$cmd" 2>&1)"; then
      echo "eclean-githooks: verify failed ($cmd); commit blocked" >&2
      printf '%s\n' "$out" | tail -n 40 >&2
      exit 1
    fi
  fi
fi

gitdir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$gitdir" ] && [ -x "$gitdir/hooks/$name" ]; then
  exec "$gitdir/hooks/$name" "$@"
fi
exit 0
